{
  "name": "mcp-census-data",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mcp-census-data": "dist/stdio.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "build:catalog": "node dist/scripts/build-catalog.js",
    "build:geo": "node dist/scripts/build-geo.js",
    "dev": "tsc --watch",
    "check:profile": "node dist/scripts/check-profile.js",
    "build:acs": "node dist/scripts/build-acs.js",
    "deploy:check": "node dist/scripts/deploy-check.js",
    "deploy": "npm run build && npm run deploy:check && fly deploy --ha=false",
    "build:places": "node dist/scripts/build-places.js",
    "build:snap": "node dist/scripts/build-snap.js"
  },
  "dependencies": {
    "@duckdb/node-api": "^2.0.1-r.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
